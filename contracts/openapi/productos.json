  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "aud=credimarket-api; rol y propietario validados por backend"
      },
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "aud=credimarket-internal; identidad de servicio y scopes"
      }
    },
    "schemas": {
      "Cotizacion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "producto_id": {
            "type": "string",
            "format": "uuid"
          },
          "precio_unitario_cop": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
            "description": "COP decimal exacto; reglas de positividad en la operación."
          },
          "version_producto": {
            "type": "integer",
            "minimum": 1
          },
          "activo": {
            "type": "boolean"
          },
          "cotizado_en": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "producto_id",
          "precio_unitario_cop",
          "version_producto",
          "activo",
          "cotizado_en"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id",
          "details"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "Producto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "precio_cop": {
            "type": "string",
            "pattern": "^(?!0\\.00$)(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
          },
          "activo": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nombre",
          "categoria",
          "precio_cop",
          "activo",
          "version",
          "created_at",
          "updated_at"
        ]
      },
      "ProductoCrear": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "precio_cop": {
            "type": "string",
            "pattern": "^(?!0\\.00$)(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
          }
        },
        "required": [
          "nombre",
          "categoria",
          "precio_cop"
        ]
      },
      "ProductoEditar": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version_esperada": {
            "type": "integer",
            "minimum": 1
          },
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "precio_cop": {
            "type": "string",
            "pattern": "^(?!0\\.00$)(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
          }
        },
        "required": [
          "version_esperada"
        ],
        "minProperties": 2
      },
      "Productos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Producto"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "Ready": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ready",
              "degraded",
              "unavailable"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "ok",
                "degraded",
                "unavailable"
              ]
            }
          }
        },
        "required": [
          "status",
          "dependencies"
        ]
      },
      "VersionEsperada": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version_esperada": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "version_esperada"
        ]
      }
    }
  }
}
